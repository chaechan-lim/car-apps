<?xml version="1.0" encoding="utf-8"?>
<!--
  A gauge with its needle: the app reads instruments rather than driving anything.
  Drawn as a vector so the icon ships as XML — no density buckets to generate, and
  nothing binary in the repo.

  Adaptive icon foregrounds are 108x108 with only the centre 72x72 guaranteed
  visible, so the artwork stays inside roughly x/y 30..78.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dial: an open arc, left round to right round, over the top. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M38,64 A16,16 0 1,1 70,64"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="5" />

    <!-- Needle, resting where a reading would sit rather than at either stop. -->
    <path
        android:pathData="M54,64 L64,52"
        android:strokeColor="#7FD4FF"
        android:strokeLineCap="round"
        android:strokeWidth="4" />

    <!-- Hub -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,64 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />
</vector>
