<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android Auto gates car data behind Google Play services permissions.
      These are distinct from the AAOS platform permissions (android.car.permission.*)
      used by the :automotive module — same data, different gatekeeper.
    -->
    <uses-permission android:name="com.google.android.gms.permission.CAR_FUEL" />
    <uses-permission android:name="com.google.android.gms.permission.CAR_SPEED" />
    <uses-permission android:name="com.google.android.gms.permission.CAR_MILEAGE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      Android 11 package visibility. Without this, querying Android Auto's package
      throws NameNotFound and the diagnostic reports it as absent on a phone where
      it is installed and running — a false negative in exactly the report meant to
      explain a failure.
    -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <!--
          Required. Without it the host refuses to bind with "Min API level not
          declared in manifest" and the app silently never appears in the car
          launcher — it does not fail at install time.

          Declared as 1, matching the official samples. CarInfo/CarSensors need
          level 3, but declaring 3 here would make a lower-level host skip the app
          entirely rather than run it degraded, so the level is checked at runtime
          in GroupsScreen instead — an unsupported host then says so on screen,
          which is a result, whereas an absent app is not.
        -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Listed with minCarApiLevel in the setup guide. Nothing here needs custom
             colours, but the library themes its own permission activity from this,
             which is the one screen this app makes the host draw. -->
        <meta-data
            android:name="androidx.car.app.theme"
            android:resource="@style/CarAppTheme" />

        <!-- The launcher tile takes its label and icon from the service, not the
             application element. -->
        <service
            android:name=".ProbeCarAppService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <!--
              One category, and the honest one. v0.1.2 also declared POI as a hedge
              on the theory that a filter may carry more categories than the query
              matches — true of plain intent resolution, never verified of this
              host. It also described the app as something it is not: POI means a
              map app, and the reference POI sample pairs it with the
              MAP_TEMPLATES permission this app has no use for. A declaration that
              contradicts the app is a worse bet than a narrow one.
            -->
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <activity
            android:name=".PhoneActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
